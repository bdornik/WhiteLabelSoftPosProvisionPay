<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EFF2FA"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="48dp">

        <!-- Amount Display (hidden) -->
        <TextView
            android:id="@+id/infoText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- Title Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ss3bold"
            android:text="@string/card_pin_entry_enter_pin"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- PIN Indicators (4 circles) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/pin_indicator_1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/pin_indicator_empty" />

            <View
                android:id="@+id/pin_indicator_2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/pin_indicator_empty" />

            <View
                android:id="@+id/pin_indicator_3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/pin_indicator_empty" />

            <View
                android:id="@+id/pin_indicator_4"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/pin_indicator_empty" />
        </LinearLayout>

        <!-- Hidden PIN Text (required by SDK) -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/pinText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="60dp" />

        <!-- Numeric Keypad -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Row 1: 1, 2, 3 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/keypad_1_container"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pin_keypad_button"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/keypad_1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:scaleType="fitXY" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/keypad_2_container"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pin_keypad_button"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/keypad_2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:scaleType="fitXY" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/keypad_3_container"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/pin_keypad_button"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/keypad_3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:scaleType="fitXY" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Row 2: 4, 5, 6 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/keypad_4_container"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pin_keypad_button"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/keypad_4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:scaleType="fitXY" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/keypad_5_container"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pin_keypad_button"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/keypad_5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:scaleType="fitXY" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/keypad_6_container"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/pin_keypad_button"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/keypad_6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:scaleType="fitXY" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Row 3: 7, 8, 9 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/keypad_7_container"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pin_keypad_button"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/keypad_7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:scaleType="fitXY" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/keypad_8_container"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pin_keypad_button"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/keypad_8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:scaleType="fitXY" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/keypad_9_container"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/pin_keypad_button"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/keypad_9"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:scaleType="fitXY" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Row 4: Empty, 0, Backspace -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/keypad_ok_container"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pin_keypad_button"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/keypad_ok"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:src="@drawable/check"
                        android:scaleType="fitXY" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/keypad_0_container"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/pin_keypad_button"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/keypad_0"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:scaleType="fitXY" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/keypad_clear_container"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/pin_keypad_button"
                    android:padding="20dp">
                    <ImageView
                        android:id="@+id/keypad_clear"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:src="@drawable/backspace"
                        android:scaleType="fitCenter" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <!-- Cancel button (mapped to SDK's cancel) -->
        <LinearLayout
            android:id="@+id/keypad_cancel_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ss3regular"
                android:padding="12dp"
                android:text="@string/card_pin_entry_cancel"
                android:textColor="#E53935"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/keypad_cancel"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Countdown Timer (hidden) -->
        <TextView
            android:id="@+id/countDownText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</layout>
